    "import torch\n",
    "from models.hr_mamba import HRMambaRegressor\n",
    "\n",
    "model = HRMambaRegressor(\n",
    "    input_channels=3,\n",
    "    seq_len=300,\n",
    "    patch_size=15,\n",
    "    stride=15,\n",
    "    d_model=128,\n",
    "    depth=4,\n",
    "    d_state=16,\n",
    ")\n",
    "\n",
    "x = torch.randn(8, 300, 3)\n",
    "y = model(x)\n",
    "\n",
    "print(y.shape)"
   ]
